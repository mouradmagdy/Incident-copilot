{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Groq": {
    "BaseUrl": "https://api.groq.com/openai/v1",
    "Model": "openai/gpt-oss-120b"
  },
  "EmbeddingService": {
    "BaseUrl": "http://localhost:8000"
  },
  "Knowledge": {
    "RunbooksPath": "../../docs/runbooks",
    "TargetChunkSize": 800,
    "ChunkOverlap": 100
  },
  "TelemetrySimulation": {
    "Interval": "00:00:10",
    "Scenario": "Healthy"
  },
  "Jwt": {
    "Issuer": "IncidentCopilot",
    "Audience": "IncidentCopilot.Web",
    "AccessTokenMinutes": 480
  },
  "AllowedHosts": "*"
}
