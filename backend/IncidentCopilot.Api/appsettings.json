{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Groq": {
    "BaseUrl": "https://api.groq.com/openai/v1",
    "Model": "openai/gpt-oss-120b"
  },
  "EmbeddingService": {
    "BaseUrl": "http://localhost:8000"
  },
  "Knowledge": {
    "RunbooksPath": "../../docs/runbooks",
    "TargetChunkSize": 800,
    "ChunkOverlap": 100
  },
  "ChatDiagnostics": {
    "IncludeChunkContent": false,
    "ChunkContentLimit": 800
  },
  "AllowedHosts": "*"
}
